# Smart Billing License Server — Environment Variables
# Copy this to .env for local development (never commit .env to git)

PORT=3000

# Admin dashboard credentials
ADMIN_USERNAME=CloudSprint
ADMIN_PASSWORD=CloudSprint_Admin_2024_Secure

# API secret (used for dashboard token auth)
API_SECRET=cs_admin_2024_secure

# License key HMAC secret (must match license-validator.js in desktop app)
LICENSE_SECRET=SB@CloudSprint#2024!SmartBilling$Key@Secure99

# JWT signing secret
JWT_SECRET=SB_JWT_CloudSprint_2024_Ultra_Secure_Key_99

# Max devices per license key (default 1)
MAX_DEVICES=1

# Set automatically by Render — used for keep-alive ping
# RENDER_EXTERNAL_URL=https://smartbilling-license.onrender.com
